[Unit]
Description=Wealthfolio backup (data volume + config)
After=docker.service

[Service]
Type=oneshot
# Point WorkingDirectory and ExecStart at your Wealthfolio clone.
WorkingDirectory=%h/wealthfolio
# aws lives in /opt/linuxbrew/bin, which systemd's default user PATH does not include;
# without this the S3 sync fails and backup.sh only logs a warning.
Environment=PATH=/opt/linuxbrew/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/wealthfolio/ops/backup.sh
